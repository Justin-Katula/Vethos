{
  "expo": {
    "name": "Vethos",
    "slug": "vethos",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": [
      "vethos",
      "device-activity"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vethos.app",
      "supportsTablet": true,
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "Vethos uses Screen Time to set aside the apps you picked yourself, for the length of a session you started. Nothing leaves your phone — iOS never tells Vethos which apps they are.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "processing"
        ]
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.vethos.app"
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.vethos.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.vethos.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.vethos.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "862f46d8-f1a7-404e-8ea9-cd20027d21fd"
      }
    },
    "owner": "justin-katula"
  }
}
