{
  "expo": {
    "name": "Vethos",
    "slug": "vethos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": [
      "vethos",
      "device-activity"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.vethos.app",
      "appleTeamId": "7R7TRVFDCW",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "Vethos uses Screen Time to set aside the apps you picked yourself, for the length of a session you started. Nothing leaves your phone — iOS never tells Vethos which apps they are.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true
      },
      "icon": "./assets/icon-argent.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.vethos.app",
          "copyToTargetFolder": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-argent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon-argent.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.vethos.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.vethos.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.vethos.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.vethos.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "862f46d8-f1a7-404e-8ea9-cd20027d21fd"
      },
      "coachUrl": "https://aflefvivzyarsqwuwazz.supabase.co/functions/v1/coach",
      "supabase": {
        "url": "https://aflefvivzyarsqwuwazz.supabase.co",
        "cle": "sb_publishable_yWPi5fusuadTzx7P-ZqJiA_Y5WUxcg7",
        "apple": true,
        "googleWeb": "444529886127-brgdi3l5b374egddk2g731ro8l5lh69q.apps.googleusercontent.com",
        "googleIos": ""
      },
      "revenuecat": {
        "ios": "",
        "android": ""
      },
      "liens": {
        "confidentialite": ""
      }
    },
    "owner": "justin-katula",
    "icon": "./assets/icon-argent.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/862f46d8-f1a7-404e-8ea9-cd20027d21fd"
    },
    "android": {}
  }
}
